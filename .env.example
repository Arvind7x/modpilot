# Copy this file to ".env" and paste your real tokens. NEVER commit .env to git.
DISCORD_TOKEN=paste-discord-bot-token-here
# Optional: your test server ID (right-click server icon > Copy Server ID, needs Developer Mode ON).
# Makes slash commands appear instantly while testing. Leave 0 for global (takes ~1h to appear).
TEST_GUILD_ID=0
# Optional: paste ONLY when ready to test AI (free credits claimed). Leave empty otherwise.
ANTHROPIC_API_KEY=
# Optional: OpenRouter fallback (your $0.80 lives here). Get key at openrouter.ai → Keys.
OPENROUTER_API_KEY=
# Cheap model for summaries. If bot says "model not found", pick a current cheap ID
# from openrouter.ai/models and paste it here.
OPENROUTER_MODEL=deepseek/deepseek-chat
